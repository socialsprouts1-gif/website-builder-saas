# ---------------------------------------------------------------- core ----
# Public URL of this deployment. Used for OAuth redirects and the chatbot
# embed snippet, so it must match the origin users actually reach.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------ supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# -------------------------------------------------------------- openai ----
# Lumen's pooled key. Every account gets a small monthly allowance on it;
# beyond that users add their own key in Settings and are billed by OpenAI.
# Leave blank to make bring-your-own-key mandatory.
OPENAI_API_KEY=

# Optional override for when OpenAI's naming shifts and the bucketing
# heuristics misread it, e.g. {"quality":"gpt-6","fast":"gpt-6-mini"}
LUMEN_MODEL_OVERRIDES=

# ---------------------------------------------------------- encryption ----
# 32 bytes, base64 or hex. Encrypts every stored third-party credential.
# Generate with: openssl rand -base64 32
LUMEN_ENCRYPTION_KEY=

# ------------------------------------------------------------ razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The ₹500/month plan you created in the Razorpay dashboard.
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------- connectors ----
# Each is optional. A connector without credentials renders as
# "not configured on this deployment" rather than breaking.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
